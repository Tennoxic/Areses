# Copy this file to .env (or export these as real environment variables) and
# adjust as needed. All settings are optional -- ARESES runs zero-config with
# the defaults below, which target local/LAN use.

# SQLAlchemy async database URL. Defaults to a SQLite file under ./data.
# ARESES_DATABASE_URL=sqlite+aiosqlite:///./data/areses.db

# true (default): plain HTTP on your LAN, session cookies are not marked
# "secure" so they still work without HTTPS. Set to false if you're putting
# ARESES behind a reverse proxy with real HTTPS and exposing it beyond your
# LAN -- getting this backwards breaks login (see app/core/config.py).
# ARESES_LOCAL_MODE=true

# Only used to build the link inside password-reset emails. Falls back to
# the admin-configurable "Base URL" field in Settings, then to
# http://localhost:8000.
# ARESES_BASE_URL=http://localhost:8000

# Encrypts secrets at rest (SMTP password, AI provider API key, VAPID push
# key, per-feed HTTP auth passwords). If unset, a key is auto-generated on
# first run and stored in the data directory next to the database -- fine
# for local use, but means a copy of that directory can decrypt those
# secrets. Generate one with:
#   python -m app.core.crypto generate-key
# ARESES_SECRET_KEY=

# Comma-separated extra origins allowed to call the API with credentials,
# on top of the built-in localhost:5173 dev defaults.
# ARESES_CORS_ORIGINS=
